    "Arguments are passed individually. For shell pipelines, explicitly choose an interpreter and its arguments. Environment values are saved locally; avoid putting secrets here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments are passed individually. For shell pipelines, explicitly choose an interpreter and its arguments. Environment values are saved locally; avoid putting secrets here."
