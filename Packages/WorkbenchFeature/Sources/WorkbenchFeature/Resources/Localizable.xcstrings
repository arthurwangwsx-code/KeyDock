    "API keys cannot be stored in this isolated preview. Use a regular build to save a key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys cannot be stored in this isolated preview. Use a regular build to save a key."
