    },
    "AI usage history cleared. Running requests may create new records when they finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI usage history cleared. Running requests may create new records when they finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 用量记录已清除。正在运行的请求结束后可能产生新记录。"
          }
        }
      }
    },
    "AI usage history was only partly cleared. Some records remain; check permissions and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI usage history was only partly cleared. Some records remain; check permissions and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 用量记录仅部分清除，仍有记录保留。请检查权限后重试。"
