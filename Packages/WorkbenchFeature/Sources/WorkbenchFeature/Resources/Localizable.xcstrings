    "Commands, workflows and agents that have already started keep their original settings and permissions. Stop them in Tasks if needed. Enabling a tool does not give agents access to it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands, workflows and agents that have already started keep their original settings and permissions. Stop them in Tasks if needed. Enabling a tool does not give agents access to it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启动的命令、工作流和 Agent 会按启动时的设置与权限继续运行。如需停止，请前往任务。启用工具不会自动将它授权给 Agent。"
          }
        }
      }
    },
