    "AI usage could not be read. Refresh to try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI usage could not be read. Refresh to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 AI 用量，请刷新重试。"
