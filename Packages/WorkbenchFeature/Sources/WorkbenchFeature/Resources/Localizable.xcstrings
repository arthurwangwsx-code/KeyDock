    },
    "API configuration could not be saved and rollback was incomplete. Check the saved endpoint and API key before retrying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API configuration could not be saved and rollback was incomplete. Check the saved endpoint and API key before retrying."
