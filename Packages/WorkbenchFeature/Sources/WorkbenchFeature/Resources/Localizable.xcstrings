    "Refresh sends only a model-list request to this service. It does not change selections, verify model capabilities or update official recommendations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh sends only a model-list request to this service. It does not change selections, verify model capabilities or update official recommendations."
