{
  "sourceLanguage": "en",
  "strings": {
    "A collection can contain up to 32 actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A collection can contain up to 32 actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个集合最多包含 32 个动作。"
          }
        }
      }
    },
    "A configuration source is unavailable. It cannot be exported as an empty list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuration source is unavailable. It cannot be exported as an empty list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置来源不可用，无法将其作为空列表导出。"
          }
        }
      }
    },
    "A definition or reference is invalid. Review saved definitions and shortcuts before exporting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A definition or reference is invalid. Review saved definitions and shortcuts before exporting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个定义或引用无效。请先检查已保存的定义和快捷键。"
          }
        }
      }
    },
    "A desktop request may already have taken effect. Check the target application before retrying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A desktop request may already have taken effect. Check the target application before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面操作请求可能已经生效。重试前请先检查目标应用。"
          }
        }
      }
    },
    "A new attempt may repeat completed work. Unknown effects cannot be undone or assumed safe to repeat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new attempt may repeat completed work. Unknown effects cannot be undone or assumed safe to repeat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新尝试可能重复已完成的操作。未知效果无法撤销，也不能据此认定重复执行安全。"
          }
        }
      }
    },
    "A rate already exists for this exact service and model. Edit that rate instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rate already exists for this exact service and model. Edit that rate instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务与准确模型已设有费率，请编辑现有费率。"
          }
        }
      }
    },
    "A schedule was paused because its workflow, command or AI target changed. Review it before enabling again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流、命令或 AI 目标已更改，此计划已暂停。请检查后再重新启用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A schedule was paused because its workflow, command or AI target changed. Review it before enabling again."
          }
        }
      }
    },
    "A selected item is no longer available. Remove it or select the items again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected item is no longer available. Remove it or select the items again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个已选条目已失效。请移除该条目或重新选择。"
          }
        }
      }
    },
    "A tool may have effects. Check the result before starting a new run; nothing was replayed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具可能已产生实际影响。开始新运行前请先核实结果；未自动重放任何操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tool may have effects. Check the result before starting a new run; nothing was replayed."
          }
        }
      }
    },
    "A workflow step may have effects. Check the result before starting a new run; nothing was replayed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流步骤可能已产生实际影响。开始新运行前请先核实结果；未自动重放任何操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workflow step may have effects. Check the result before starting a new run; nothing was replayed."
          }
        }
      }
    },
