    "Arguments (JSON array)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments (JSON array)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数（JSON 数组）"
          }
        }
      }
    },
    "Arguments and environment must be valid JSON": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments and environment must be valid JSON"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数和环境变量必须使用有效的 JSON 格式"
          }
        }
      }
    },
    "Arguments are passed individually. For shell pipelines, explicitly choose an interpreter and its arguments. Environment values are saved locally; avoid putting secrets here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments are passed individually. For shell pipelines, explicitly choose an interpreter and its arguments. Environment values are saved locally; avoid putting secrets here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数逐项传递。使用 shell 管道时，请明确选择解释器及其参数。环境变量值保存在本机，请勿在此填写密钥等敏感信息。"
          }
        }
      }
    },
    "Arguments are passed individually. The server receives a minimal environment, not your model credentials or terminal environment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数会逐项传入。服务器仅获得最小环境，不会获得模型凭据或终端环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arguments are passed individually. The server receives a minimal environment, not your model credentials or terminal environment."
          }
        }
      }
    },
    "Arithmetic expression": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "算术表达式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arithmetic expression"
          }
        }
      }
    },
    "Arithmetic only: +, −, ×, / and parentheses. No scripts or functions are executed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持算术运算：+、−、×、/ 和括号。不执行脚本或函数。"
          }
        },
