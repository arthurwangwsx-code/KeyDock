    "Runs only while KeyDock is open. Missed times after sleep merge into one run. Interactive steps and dynamic command arguments cannot run unattended. Changed commands or AI targets require a new approval.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 KeyDock 运行时执行。睡眠期间错过的计划时间会合并为一次运行。交互步骤和带动态参数的命令不能无人值守运行。命令或 AI 目标更改后，需要重新批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs only while KeyDock is open. Missed times after sleep merge into one run. Interactive steps and dynamic command arguments cannot run unattended. Changed commands or AI targets require a new approval."
