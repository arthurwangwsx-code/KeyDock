      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI服务"
          }
        }
      }
    },
    "AI action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI action"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 动作"
          }
        }
      }
    },
    "AI draft only. Review command, directory and effects before saving or running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI draft only. Review command, directory and effects before saving or running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是 AI 草稿。保存或运行前，请检查命令、目录及其影响。"
          }
        }
      }
    },
    "AI drafts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 草稿"
          }
        }
      }
    },
    "AI finished, but its task receipt could not be saved. Do not retry automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI finished, but its task receipt could not be saved. Do not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已结束，但无法保存任务回执。请勿自动重试。"
          }
        }
      }
    },
    "AI input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 输入"
          }
        }
      }
    },
    "AI request failed. Check endpoint, model, connectivity and compatibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI request failed. Check endpoint, model, connectivity and compatibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求失败，请检查端点、模型、网络连接及兼容性。"
          }
        }
      }
    },
    "AI request was not sent because its task receipt could not be saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI request was not sent because its task receipt could not be saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存任务回执，AI 请求未发送。"
          }
        }
      }
    },
    "AI usage history cleared. Running requests may create new records when they finish.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI usage history cleared. Running requests may create new records when they finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 用量记录已清除。正在运行的请求结束后可能产生新记录。"
          }
        }
      }
    },
    "AI usage history was only partly cleared. Some records remain; check permissions and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI usage history was only partly cleared. Some records remain; check permissions and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 用量记录仅部分清除，仍有记录保留。请检查权限后重试。"
          }
        }
      }
    },
    "AI workspace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI workspace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工作台"
          }
        }
      }
    },
    "API authentication failed; check the stored key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API authentication failed; check the stored key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 身份验证失败，请检查已保存的密钥"
          }
        }
      }
    },
    "API configuration could not be saved and rollback was incomplete. Check the saved endpoint and API key before retrying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API configuration could not be saved and rollback was incomplete. Check the saved endpoint and API key before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存 API 配置，且未能完整恢复原设置。重试前请检查已保存的端点和 API 密钥。"
          }
        }
      }
    },
    "API configuration could not be saved; active settings were preserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API configuration could not be saved; active settings were preserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存 API 配置，已保留当前生效设置"
