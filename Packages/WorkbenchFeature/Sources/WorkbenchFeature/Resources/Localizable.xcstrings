    "Text import": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本导入"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text import"
          }
        }
      }
    },
    "Text only · 24 hours · 500 items · 1 MiB per item · 32 MiB of text. Pinned items count toward capacity and stay until removed. When they leave too little room, new items are skipped without deleting existing history. Concealed and transient types are skipped; some applications do not mark secrets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only · 24 hours · 500 items · 1 MiB per item · 32 MiB of text. Pinned items count toward capacity and stay until removed. When they leave too little room, new items are skipped without deleting existing history. Concealed and transient types are skipped; some applications do not mark secrets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录文本 · 保留 24 小时 · 最多 500 条 · 单条 1 MiB · 文本总量 32 MiB。固定条目计入容量并保留至手动删除；剩余空间不足时不接纳新条目，也不删除原有历史。跳过带隐藏或临时标记的内容；部分应用不会标记敏感信息。"
          }
        }
      }
    },
    "The application list may be out of date. Refresh it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application list may be out of date. Refresh it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用列表可能已过期，请刷新后重试。"
          }
        }
      }
    },
    "The application opened, but macOS could not bring it to the front.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application opened, but macOS could not bring it to the front."
          }
