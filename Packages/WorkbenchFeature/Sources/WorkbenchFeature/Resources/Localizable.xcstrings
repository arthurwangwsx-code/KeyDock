{
  "sourceLanguage": "en",
  "strings": {
    "A new attempt rechecks current scope and may repeat completed work. Unknown effects must be checked first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的尝试会重新检查当前授权范围，并可能重复已完成的操作。请先核实结果不明的操作是否已产生影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new attempt rechecks current scope and may repeat completed work. Unknown effects must be checked first."
          }
        }
      }
    },
    "A schedule was paused because its workflow, command or AI target changed. Review it before enabling again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流、命令或 AI 目标已更改，此计划已暂停。请检查后再重新启用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A schedule was paused because its workflow, command or AI target changed. Review it before enabling again."
          }
        }
      }
    },
    "A tool may have effects. Check the result before starting a new run; nothing was replayed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具可能已产生实际影响。开始新运行前请先核实结果；未自动重放任何操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tool may have effects. Check the result before starting a new run; nothing was replayed."
          }
        }
      }
    },
    "A workflow step may have effects. Check the result before starting a new run; nothing was replayed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流步骤可能已产生实际影响。开始新运行前请先核实结果；未自动重放任何操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workflow step may have effects. Check the result before starting a new run; nothing was replayed."
          }
        }
      }
    },
    "AI": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
