    },
    "KeyDock cancels this draft’s requests and waits for them to finish before discarding its input and source. Task results keep their source labels, but selection replacement is disabled. Command editors already opened from suggestions are kept. Hiding the window keeps the draft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock cancels this draft’s requests and waits for them to finish before discarding its input and source. Task results keep their source labels, but selection replacement is disabled. Command editors already opened from suggestions are kept. Hiding the window keeps the draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock 会取消这份草稿的请求，等待任务收口后移除输入与来源。历史结果保留来源标签，但会停用原选区替换。已从建议打开的命令编辑稿会保留。隐藏窗口会保留草稿。"
          }
        }
      }
    },
    "KeyDock is at its task or text limit. Finish a task or clear older history, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock is at its task or text limit. Finish a task or clear older history, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到任务数量或文本容量上限。请等待任务结束或清除旧记录后重试。"
          }
        }
      }
    },
    "KeyDock is quitting. No new action was started.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock is quitting. No new action was started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock 正在退出，未启动新操作。"
          }
        }
      }
    },
    "KeyDock manages up to 8 tasks at once, with 200 task records, 32 AI drafts and 32 MiB of session text. Task metadata and usage expire after 90 days. Text is retained only when you enable task content retention and explicitly save it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock manages up to 8 tasks at once, with 200 task records, 32 AI drafts and 32 MiB of session text. Task metadata and usage expire after 90 days. Text is retained only when you enable task content retention and explicitly save it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "KeyDock 最多同时管理 8 个任务，保留 200 条任务记录、32 份 AI 草稿及 32 MiB 会话文本。任务元数据和用量记录在 90 天后到期。只有开启任务内容保留并明确保存，文本才会跨重启保留。"
          }
        }
      }
    },
