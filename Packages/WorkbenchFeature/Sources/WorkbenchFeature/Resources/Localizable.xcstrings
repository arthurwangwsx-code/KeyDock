      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No record · unable to confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无记录 · 无法确认"
          }
        }
      }
    },
    "No selected text. Enter text to begin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No selected text. Enter text to begin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读取到选中文本，请输入内容后开始。"
          }
        }
      }
    },
    "No separator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No separator"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无分隔符"
          }
        }
      }
    },
    "No shortcuts configured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcuts configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置快捷键"
          }
        }
      }
    },
    "Normal quit never force-quits or dismisses save dialogs. Show all windows brings windows forward; minimized windows and Spaces remain controlled by macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal quit never force-quits or dismisses save dialogs. Show all windows brings windows forward; minimized windows and Spaces remain controlled by macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常退出不会强制结束应用，也不会关闭保存提示。“显示所有窗口”会请求将窗口置前，最小化窗口和桌面空间仍由 macOS 管理。"
          }
        }
      }
    },
    "Not dispatched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not dispatched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未派发"
          }
        }
      }
    },
    "Not saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存"
          }
        }
      }
    },
    "Nothing available to view": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing available to view"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可查看的内容"
          }
        }
      }
    },
    "OCR runs locally. Files are limited to 16 MiB, images to 20 million pixels and PDFs to 30 pages. Text is limited to 128 KiB. Nothing is sent to AI until you choose an action.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR 在本地运行。文件上限为 16 MiB，图片上限为 2000 万像素，PDF 上限为 30 页，文本上限为 128 KiB。选择动作之前，不会向 AI 发送任何内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR runs locally. Files are limited to 16 MiB, images to 20 million pixels and PDFs to 30 pages. Text is limited to 128 KiB. Nothing is sent to AI until you choose an action."
          }
        }
      }
    },
    "Off by default. When enabled, future saved AI, Agent and workflow runs can capture their original input. Review and select content in Tasks before saving. Saved text expires after 7 days, with up to 200 records and 64 MiB in total.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, future saved AI, Agent and workflow runs can capture their original input. Review and select content in Tasks before saving. Saved text expires after 7 days, with up to 200 records and 64 MiB in total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，后续运行已保存的 AI 动作、Agent 和工作流时可以捕获原始输入。请在“任务”中审阅并选择内容后保存。保存文本在 7 天后到期，最多 200 份、总计 64 MiB。"
          }
        }
      }
    },
    "Older versions may leave shortcut, favorite, alias or recent preferences after a tool was deleted. Review the exact items before clearing them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older versions may leave shortcut, favorite, alias or recent preferences after a tool was deleted. Review the exact items before clearing them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本移除工具后，可能留下快捷键、收藏、别名或最近项。清理前请核对具体项目。"
          }
        }
      }
    },
    "Omitted dependencies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitted dependencies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选依赖"
          }
        }
      }
    },
    "One text input is kept in this session. A new import replaces it. Clear input removes its text and source; existing AI drafts and task results are kept in history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One text input is kept in this session. A new import replaces it. Clear input removes its text and source; existing AI drafts and task results are kept in history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话保留一份文本，新导入会替换它。清除输入将移除正文和来源；已有 AI 草稿和任务结果仍保留在历史中。"
          }
        }
      }
    },
    "Only enable sources you trust. Local servers run as your user and can access files or run commands outside KeyDock. This is not an OS sandbox. Connections start only when you connect or start an allowed Agent run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅启用信任的来源。本地服务器以当前用户身份运行，可访问文件或在 KeyDock 之外执行命令；不受操作系统沙箱隔离。仅在主动连接或开始已获允许的 Agent 运行时建立连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enable sources you trust. Local servers run as your user and can access files or run commands outside KeyDock. This is not an OS sandbox. Connections start only when you connect or start an allowed Agent run."
          }
        }
      }
    },
    "Only retained, readable request records are included. Missing, cleared, expired, incomplete and unpriced usage can leave gaps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only retained, readable request records are included. Missing, cleared, expired, incomplete and unpriced usage can leave gaps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含仍保留且可读取的请求记录。缺失、已清除、已过期、不完整或未配置费率的用量可能留下缺口。"
          }
        }
      }
    },
    "Only shortcut, favorite, alias and recent preferences for missing snippets, URL actions, collections and workflows are cleared. Saved definitions, collection contents, tasks and history are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shortcut, favorite, alias and recent preferences for missing snippets, URL actions, collections and workflows are cleared. Saved definitions, collection contents, tasks and history are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清理已不存在的片段、网页动作、集合及工作流的快捷键、收藏、别名和最近项。已保存定义、集合内容、任务和历史均保留。"
          }
        }
      }
    },
    "Only this new input is used. Results are shown without automatic copying or replacement.": {
