    "AI actions open a blank draft. Choose input and run it in AI workspace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI actions open a blank draft. Choose input and run it in AI workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 动作会打开空白草稿。请在 AI 工作台选择输入并运行。"
          }
        }
      }
    },
    "AI draft only. Review command, directory and effects before saving or running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI draft only. Review command, directory and effects before saving or running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是 AI 草稿。保存或运行前，请检查命令、目录及其影响。"
          }
        }
      }
    },
    "AI drafts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 草稿"
          }
        }
      }
    },
    "AI finished, but its task receipt could not be saved. Do not retry automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI finished, but its task receipt could not be saved. Do not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已结束，但无法保存任务回执。请勿自动重试。"
          }
        }
      }
    },
    "AI input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 输入"
