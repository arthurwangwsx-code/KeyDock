    "AI draft only. Review command, directory and effects before saving or running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI draft only. Review command, directory and effects before saving or running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只是 AI 草稿。保存或运行前，请检查命令、目录及其影响。"
          }
        }
      }
    },
    "AI finished, but its task receipt could not be saved. Do not retry automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI finished, but its task receipt could not be saved. Do not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已结束，但无法保存任务回执。请勿自动重试。"
          }
        }
      }
    },
    "AI request failed. Check endpoint, model, connectivity and compatibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI request failed. Check endpoint, model, connectivity and compatibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求失败，请检查端点、模型、网络连接及兼容性。"
          }
        }
      }
    },
    "AI request was not sent because its task receipt could not be saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI request was not sent because its task receipt could not be saved."
          }
        },
